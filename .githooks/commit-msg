#!/bin/sh
# Conventional Commits: type(scope)?: subject, subject <= 72 chars, imperative.
msg=$(head -n1 "$1")
case "$msg" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if ! printf '%s' "$msg" | grep -Eq '^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\([a-z0-9-]+\))?!?: [^ ].{0,71}$'; then
  echo "commit-msg: expected 'type(scope): subject' (Conventional Commits), got:" >&2
  echo "  $msg" >&2
  exit 1
fi
